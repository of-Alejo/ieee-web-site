# ==============================
# Seguridad básica
# ==============================

# Proteger el propio archivo .htaccess
<Files .htaccess>
    Require all denied
</Files>

# Evitar listado de directorios
Options -Indexes

# Proteger archivos sensibles
<FilesMatch "\.(env|json|log|ini|sh|bak|sql|swp|dist)$">
    Require all denied
</FilesMatch>

# ==============================
# Redirecciones y reescrituras
# ==============================

RewriteEngine On

# PASO 1: Desactivar HSTS antes de redirigir (SOLO si viene por HTTPS)
<IfModule mod_headers.c>
    Header always unset Strict-Transport-Security
    Header always set Strict-Transport-Security "max-age=0"
</IfModule>


# PASO 2: Forzar HTTP (redirigir de https:// a http://)
RewriteCond %{HTTPS} on
RewriteRule ^(.*)$ http://%{HTTP_HOST}%{REQUEST_URI} [L,R=302]

# Evitar bucles en parámetros GET
RewriteCond %{QUERY_STRING} ^i=1$ [NC]
RewriteRule (.*) /$1? [R=301,L]

# Reescribir todas las solicitudes que no sean archivos o directorios existentes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^(.+)$ index.php [QSA,L]

# ==============================
# Rendimiento optimizado
# ==============================

# Compresión GZIP/Deflate mejorada
<IfModule mod_deflate.c>
    # Comprimir tipos de archivo específicos
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml application/atom+xml image/svg+xml

    # Comprimir todos los archivos salvo imágenes y video
    SetOutputFilter DEFLATE
    SetEnvIfNoCase Request_URI \
        \.(?:gif|jpe?g|png|ico|bmp|webp|mp4|avi|mov)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \
        \.(?:exe|t?gz|zip|bz2|rar)$ no-gzip dont-vary
</IfModule>

# Cache optimizado con TTL eficientes
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML con TTL corto para contenido dinámico
    ExpiresByType text/html "access plus 10 minutes"
    
    # CSS y JS con TTL medio (pero versionas archivos)
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    
    # Imágenes con TTL largo
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/gif "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fuentes con TTL largo
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # PDFs
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ==============================
# Cabeceras de seguridad y rendimiento
# ==============================

<IfModule mod_headers.c>
    # Content Security Policy - MODIFICADO para permitir HTTP
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' https://cdnjs.cloudflare.com; connect-src 'self'; frame-src 'self' https://www.google.com;"
    
    # Seguridad
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Vary para cache inteligente
    Header append Vary "Accept-Encoding"
</IfModule>
